<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Title>EmailKitchen - Razor email preview for ASP.NET Core</Title>
        <Authors>Mateusz Mardosz</Authors>
        <Description>Preview, test, and send Razor email templates in ASP.NET Core. Edit sample data as JSON, render .cshtml to HTML, simulate Gmail and Outlook, and send test emails through your own provider.</Description>
        <PackageTags>aspnetcore;razor;email;email-template;email-preview;html-email;razor-rendering;email-testing;localization</PackageTags>
        <PackageProjectUrl>https://github.com/MardoszM/EmailKitchen</PackageProjectUrl>
        <RepositoryUrl>https://github.com/MardoszM/EmailKitchen.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>emailkitchen-icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>EmailKitchen</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\EmailKitchen.Analyzers\EmailKitchen.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\EmailKitchen.Analyzers.CodeFixes\EmailKitchen.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Kitchen/Assets/*"
                          LogicalName="EmailKitchen.%(Filename)%(Extension)" />
        <EmbeddedResource Update="Kitchen/Assets/third-party-notices.txt"
                          Pack="true" PackagePath="THIRD-PARTY-NOTICES.txt" />
        <Content Remove="Kitchen/DefaultTemplates/**/*.cshtml" Condition="'$(DesignTimeBuild)' != 'true'" />
        <Compile Remove="Kitchen/DefaultTemplates/**/*.cs" Condition="'$(DesignTimeBuild)' != 'true'" />
        <EmbeddedResource Include="Kitchen/DefaultTemplates/Shared/Layout.cshtml"
                          LogicalName="EmailKitchen.DefaultTemplates.Shared.Layout.cshtml"
                          Pack="true" PackagePath="build/EmailKitchenTemplates/Shared/Layout.cshtml" />
        <EmbeddedResource Include="Kitchen/DefaultTemplates/Shared/Layout.cshtml.cs"
                          LogicalName="EmailKitchen.DefaultTemplates.Shared.Layout.cshtml.cs"
                          Pack="true" PackagePath="build/EmailKitchenTemplates/Shared/Layout.cshtml.cs" />
        <EmbeddedResource Include="Kitchen/DefaultTemplates/TestEmail.cshtml"
                          LogicalName="EmailKitchen.DefaultTemplates.TestEmail.cshtml"
                          Pack="true" PackagePath="build/EmailKitchenTemplates/TestEmail.cshtml" />
        <EmbeddedResource Include="Kitchen/DefaultTemplates/TestEmail.cshtml.cs"
                          LogicalName="EmailKitchen.DefaultTemplates.TestEmail.cshtml.cs"
                          Pack="true" PackagePath="build/EmailKitchenTemplates/TestEmail.cshtml.cs" />
        <EmbeddedResource Include="Kitchen/DefaultTemplates/SupportedLanguages.cs"
                          LogicalName="EmailKitchen.DefaultTemplates.SupportedLanguages.cs"
                          Pack="true" PackagePath="build/EmailKitchenTemplates/SupportedLanguages.cs" />
        <EmbeddedResource Include="Kitchen/DefaultTemplates/Translations/eng.json"
                          LogicalName="EmailKitchen.DefaultTemplates.Translations.eng.json"
                          Pack="true" PackagePath="build/EmailKitchenTemplates/Translations/eng.json" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../LICENSE" Pack="true" PackagePath="/" />
        <None Include="../docs/images/emailkitchen-icon.png" Pack="true" PackagePath="emailkitchen-icon.png" />
        <None Update="build/EmailKitchen.targets" Pack="true" PackagePath="build/EmailKitchen.targets" />
        <None Update="buildTransitive/EmailKitchen.targets" Pack="true" PackagePath="buildTransitive/EmailKitchen.targets" />
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeEmailKitchenReadmeInPackage;IncludeEmailKitchenAnalyzerInPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="IncludeEmailKitchenReadmeInPackage">
        <!-- Use public URLs for images and documentation on NuGet.org. -->
        <PropertyGroup>
            <_EmailKitchenReadmePath>$(IntermediateOutputPath)nuget/README.md</_EmailKitchenReadmePath>
            <_EmailKitchenReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../README.md'))</_EmailKitchenReadmeText>
            <_EmailKitchenReadmeText>$(_EmailKitchenReadmeText.Replace('](docs/images/', '](https://raw.githubusercontent.com/MardoszM/EmailKitchen/main/docs/images/'))</_EmailKitchenReadmeText>
            <_EmailKitchenReadmeText>$(_EmailKitchenReadmeText.Replace('](docs/configuration.md', '](https://github.com/MardoszM/EmailKitchen/blob/main/docs/configuration.md'))</_EmailKitchenReadmeText>
        </PropertyGroup>
        <WriteLinesToFile File="$(_EmailKitchenReadmePath)" Lines="$([MSBuild]::Escape($(_EmailKitchenReadmeText.TrimEnd())))"
                          Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(_EmailKitchenReadmePath)" PackagePath="$(PackageReadmeFile)" />
        </ItemGroup>
    </Target>

    <Target Name="IncludeEmailKitchenAnalyzerInPackage">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../EmailKitchen.Analyzers/bin/$(Configuration)/netstandard2.0/EmailKitchen.Analyzers.dll">
                <PackagePath>analyzers/dotnet/cs/</PackagePath>
            </TfmSpecificPackageFile>
            <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../EmailKitchen.Analyzers.CodeFixes/bin/$(Configuration)/netstandard2.0/EmailKitchen.Analyzers.CodeFixes.dll">
                <PackagePath>buildTransitive/EmailKitchen.CodeFixes/</PackagePath>
            </TfmSpecificPackageFile>
            <TfmSpecificPackageFile Include="$(NuGetPackageRoot)system.composition.attributedmodel/9.0.0/lib/netstandard2.0/System.Composition.AttributedModel.dll">
                <PackagePath>buildTransitive/EmailKitchen.CodeFixes/</PackagePath>
            </TfmSpecificPackageFile>
            <TfmSpecificPackageFile Include="$(NuGetPackageRoot)system.composition.runtime/9.0.0/lib/netstandard2.0/System.Composition.Runtime.dll">
                <PackagePath>buildTransitive/EmailKitchen.CodeFixes/</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>
</Project>
