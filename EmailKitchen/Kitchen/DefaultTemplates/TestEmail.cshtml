@using EmailKitchen.Services
@model EmailKitchen.Templates.TestEmailModel
@inject IEmailTranslator T
@{
    Layout = "Shared/Layout.cshtml";
    ViewData["EmailKitchenLayout"] = Model;
    var lang = Model.Language.ToString();
    ViewData["Title"] = T.T("testEmail.title", lang);
    ViewData["Preheader"] = Model.Preheader ?? T.T("testEmail.preheader", lang);

    (string Name, string Url, string Badge, string Color, string DescriptionKey)[] resources =
    [
        ("Google", "https://www.google.com/", "G", "#14376e", "testEmail.resources.google"),
        ("LinkedIn", "https://www.linkedin.com/", "in", "#043e73", "testEmail.resources.linkedin"),
        ("GitHub", "https://github.com/", "GH", "#293648", "testEmail.resources.github"),
        ("Wikipedia", "https://www.wikipedia.org/", "W", "#423478", "testEmail.resources.wikipedia"),
        ("Microsoft", "https://www.microsoft.com/", "M", "#0e4225", "testEmail.resources.microsoft")
    ];
}

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
       style="font-family:Arial,Helvetica,sans-serif;">
    <tr>
        <td style="padding:0 0 8px;">
            <p class="email-eyebrow"
               style="margin:0; color:#965c3d; font-size:11px; line-height:16px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase;">
                @T.T("testEmail.eyebrow", lang)
            </p>
        </td>
    </tr>
    <tr>
        <td style="padding:0 0 12px;">
            <h1 class="email-heading"
                style="margin:0; color:#2b2b2b; font-size:28px; line-height:34px; font-weight:700;">
                @T.T("testEmail.greeting", lang, Model.Name ?? string.Empty)
            </h1>
        </td>
    </tr>
    <tr>
        <td style="padding:0 0 24px;">
            <p class="email-message" style="margin:0; color:#4a4a4a; font-size:15px; line-height:24px;">
                @(Model.Message ?? T.T("testEmail.message", lang))
            </p>
        </td>
    </tr>
    <tr>
        <td>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="#f5f5f5"
                   class="resource-card"
                   style="background-color:#f5f5f5; border:1px solid #d9d9d9; border-radius:12px; font-family:Arial,Helvetica,sans-serif;">
                <tr>
                    <td style="padding:16px 16px 6px;">
                        <p class="resource-section-heading"
                           style="margin:0; color:#965c3d; font-size:11px; line-height:16px; font-weight:700; letter-spacing:1px; text-transform:uppercase;">
                            @T.T("testEmail.resources.title", lang)
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 16px 10px;">
                        <p class="resource-section-copy"
                           style="margin:0; color:#4a4a4a; font-size:13px; line-height:20px;">
                            @T.T("testEmail.resources.description", lang)
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 16px 4px;">
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
                               style="font-family:Arial,Helvetica,sans-serif;">
                            @foreach (var resource in resources)
                            {
                                <tr>
                                    <td class="resource-row" width="36" valign="top"
                                        style="padding:12px 0; border-top:1px solid #d9d9d9;">
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                                               width="28">
                                            <tr>
                                                <td class="resource-badge resource-badge-@(resource.Name.ToLowerInvariant())"
                                                    align="center" valign="middle" width="28" height="24"
                                                    bgcolor="@resource.Color"
                                                    style="width:28px; height:24px; background-color:@resource.Color; border-radius:6px; color:#ffffff; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:16px; font-weight:700;">
                                                    @resource.Badge
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td class="resource-row" valign="top"
                                        style="padding:12px 0; border-top:1px solid #d9d9d9;">
                                        <a class="resource-link" href="@resource.Url" target="_blank"
                                           rel="noopener noreferrer"
                                           style="color:#2b2b2b; font-size:14px; line-height:20px; font-weight:700; text-decoration:underline;">@resource.Name</a>
                                        <p class="resource-description"
                                           style="margin:0; color:#626262; font-size:12px; line-height:18px;">
                                            @T.T(resource.DescriptionKey, lang)
                                        </p>
                                    </td>
                                    <td class="resource-row" width="24" align="right" valign="top"
                                        style="padding:12px 0; border-top:1px solid #d9d9d9; font-size:16px; line-height:20px;">
                                        <a class="resource-arrow" href="@resource.Url" target="_blank"
                                           rel="noopener noreferrer"
                                           aria-label="@T.T("testEmail.resources.open", lang, resource.Name)"
                                           style="color:#965c3d; text-decoration:none;">↗</a>
                                    </td>
                                </tr>
                            }
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td style="padding:20px 0 0;">
            <p class="email-signoff" style="margin:0; color:#4a4a4a; font-size:13px; line-height:20px;">
                @T.T("testEmail.signoff", lang)
            </p>
        </td>
    </tr>
</table>
