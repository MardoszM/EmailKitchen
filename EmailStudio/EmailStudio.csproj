<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../EmailStudio.Analyzers/EmailStudio.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <ProjectReference Include="../EmailStudio.Analyzers.CodeFixes/EmailStudio.Analyzers.CodeFixes.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Studio/Assets/*"
                          LogicalName="EmailStudio.%(Filename)%(Extension)" />
        <Content Remove="Studio/DefaultTemplates/**/*.cshtml" Condition="'$(DesignTimeBuild)' != 'true'" />
        <Compile Remove="Studio/DefaultTemplates/**/*.cshtml.cs" Condition="'$(DesignTimeBuild)' != 'true'" />
        <EmbeddedResource Include="Studio/DefaultTemplates/Shared/Layout.cshtml"
                          LogicalName="EmailStudio.DefaultTemplates.Shared.Layout.cshtml"
                          Pack="true" PackagePath="build/EmailStudioTemplates/Shared/Layout.cshtml" />
        <EmbeddedResource Include="Studio/DefaultTemplates/Shared/Layout.cshtml.cs"
                          LogicalName="EmailStudio.DefaultTemplates.Shared.Layout.cshtml.cs"
                          Pack="true" PackagePath="build/EmailStudioTemplates/Shared/Layout.cshtml.cs" />
        <EmbeddedResource Include="Studio/DefaultTemplates/TestEmail.cshtml"
                          LogicalName="EmailStudio.DefaultTemplates.TestEmail.cshtml"
                          Pack="true" PackagePath="build/EmailStudioTemplates/TestEmail.cshtml" />
        <EmbeddedResource Include="Studio/DefaultTemplates/TestEmail.cshtml.cs"
                          LogicalName="EmailStudio.DefaultTemplates.TestEmail.cshtml.cs"
                          Pack="true" PackagePath="build/EmailStudioTemplates/TestEmail.cshtml.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="README.md" />
        <None Update="build/EmailStudio.targets" Pack="true" PackagePath="build/EmailStudio.targets" />
        <None Update="buildTransitive/EmailStudio.targets" Pack="true" PackagePath="buildTransitive/EmailStudio.targets" />
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeEmailStudioAnalyzerInPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="IncludeEmailStudioAnalyzerInPackage">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../EmailStudio.Analyzers/bin/$(Configuration)/netstandard2.0/EmailStudio.Analyzers.dll">
                <PackagePath>analyzers/dotnet/cs/</PackagePath>
            </TfmSpecificPackageFile>
            <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../EmailStudio.Analyzers.CodeFixes/bin/$(Configuration)/netstandard2.0/EmailStudio.Analyzers.CodeFixes.dll">
                <PackagePath>buildTransitive/EmailStudio.CodeFixes/</PackagePath>
            </TfmSpecificPackageFile>
            <TfmSpecificPackageFile Include="$(NuGetPackageRoot)system.composition.attributedmodel/9.0.0/lib/netstandard2.0/System.Composition.AttributedModel.dll">
                <PackagePath>buildTransitive/EmailStudio.CodeFixes/</PackagePath>
            </TfmSpecificPackageFile>
            <TfmSpecificPackageFile Include="$(NuGetPackageRoot)system.composition.runtime/9.0.0/lib/netstandard2.0/System.Composition.Runtime.dll">
                <PackagePath>buildTransitive/EmailStudio.CodeFixes/</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>
</Project>
