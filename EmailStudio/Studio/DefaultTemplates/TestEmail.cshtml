@model EmailStudio.Templates.TestEmailModel
@{
    Layout = "Shared/Layout.cshtml";
    ViewData["EmailStudioLayout"] = Model;
    ViewData["Title"] = "Welcome — a few good places to start";
    ViewData["Preheader"] = Model.Preheader;
}

<p class="email-eyebrow" style="margin:0 0 8px; color:#0f766e; font-family:Arial,Helvetica,sans-serif; font-size:11px; line-height:16px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase;">
    A quick welcome
</p>
<h1 class="email-heading" style="margin:0 0 12px; color:#101828; font-family:Arial,Helvetica,sans-serif; font-size:28px; line-height:34px; font-weight:700;">
    Hello @Model.Name,
</h1>
<p class="email-message" style="margin:0; color:#475569; font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:24px;">
    @Model.Message
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="resource-card"
       style="margin-top:26px; background-color:#f8fafc; border:1px solid #e5e7eb; border-radius:12px;">
    <tr>
        <td style="padding:20px 20px 8px;">
            <p class="resource-section-heading" style="margin:0 0 6px; color:#0f766e; font-family:Arial,Helvetica,sans-serif; font-size:11px; line-height:16px; font-weight:700; letter-spacing:1px; text-transform:uppercase;">
                A few good places to start
            </p>
            <p class="resource-section-copy" style="margin:0; color:#475569; font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:20px;">
                Pick a link, follow an idea, and see where it takes you.
            </p>
        </td>
    </tr>
    <tr>
        <td style="padding:0 20px 12px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                    <td class="resource-row" width="42" valign="top" style="padding:14px 0; border-top:1px solid #e5e7eb;">
                        <span class="resource-badge resource-badge-google" style="display:inline-block; padding:5px 8px; border-radius:7px; background-color:#4285f4; color:#ffffff; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:16px; font-weight:700;">G</span>
                    </td>
                    <td class="resource-row" style="padding:14px 8px; border-top:1px solid #e5e7eb; font-family:Arial,Helvetica,sans-serif;">
                        <a class="resource-link" href="https://www.google.com/" target="_blank" rel="noopener noreferrer" style="color:#0f172a; font-size:14px; line-height:20px; font-weight:700; text-decoration:underline;">Google</a>
                        <div class="resource-description" style="margin-top:2px; color:#64748b; font-size:12px; line-height:18px;">Search for your next idea</div>
                    </td>
                    <td class="resource-row resource-arrow" align="right" style="padding:0; border-top:1px solid #e5e7eb; color:#0f766e; font-family:Arial,Helvetica,sans-serif; font-size:16px;"><a href="https://www.google.com/" target="_blank" rel="noopener noreferrer" aria-label="Open Google" style="display:block; padding:14px 0 14px 12px; color:inherit; text-decoration:none;">↗</a></td>
                </tr>
                <tr>
                    <td class="resource-row" width="42" valign="top" style="padding:14px 0; border-top:1px solid #e5e7eb;">
                        <span class="resource-badge resource-badge-linkedin" style="display:inline-block; padding:5px 8px; border-radius:7px; background-color:#0a66c2; color:#ffffff; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:16px; font-weight:700;">in</span>
                    </td>
                    <td class="resource-row" style="padding:14px 8px; border-top:1px solid #e5e7eb; font-family:Arial,Helvetica,sans-serif;">
                        <a class="resource-link" href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer" style="color:#0f172a; font-size:14px; line-height:20px; font-weight:700; text-decoration:underline;">LinkedIn</a>
                        <div class="resource-description" style="margin-top:2px; color:#64748b; font-size:12px; line-height:18px;">Meet people and follow your field</div>
                    </td>
                    <td class="resource-row resource-arrow" align="right" style="padding:0; border-top:1px solid #e5e7eb; color:#0f766e; font-family:Arial,Helvetica,sans-serif; font-size:16px;"><a href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer" aria-label="Open LinkedIn" style="display:block; padding:14px 0 14px 12px; color:inherit; text-decoration:none;">↗</a></td>
                </tr>
                <tr>
                    <td class="resource-row" width="42" valign="top" style="padding:14px 0; border-top:1px solid #e5e7eb;">
                        <span class="resource-badge resource-badge-github" style="display:inline-block; padding:5px 8px; border-radius:7px; background-color:#334155; color:#ffffff; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:16px; font-weight:700;">GH</span>
                    </td>
                    <td class="resource-row" style="padding:14px 8px; border-top:1px solid #e5e7eb; font-family:Arial,Helvetica,sans-serif;">
                        <a class="resource-link" href="https://github.com/" target="_blank" rel="noopener noreferrer" style="color:#0f172a; font-size:14px; line-height:20px; font-weight:700; text-decoration:underline;">GitHub</a>
                        <div class="resource-description" style="margin-top:2px; color:#64748b; font-size:12px; line-height:18px;">Discover projects and makers</div>
                    </td>
                    <td class="resource-row resource-arrow" align="right" style="padding:0; border-top:1px solid #e5e7eb; color:#0f766e; font-family:Arial,Helvetica,sans-serif; font-size:16px;"><a href="https://github.com/" target="_blank" rel="noopener noreferrer" aria-label="Open GitHub" style="display:block; padding:14px 0 14px 12px; color:inherit; text-decoration:none;">↗</a></td>
                </tr>
                <tr>
                    <td class="resource-row" width="42" valign="top" style="padding:14px 0; border-top:1px solid #e5e7eb;">
                        <span class="resource-badge resource-badge-wikipedia" style="display:inline-block; padding:5px 8px; border-radius:7px; background-color:#6257a5; color:#ffffff; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:16px; font-weight:700;">W</span>
                    </td>
                    <td class="resource-row" style="padding:14px 8px; border-top:1px solid #e5e7eb; font-family:Arial,Helvetica,sans-serif;">
                        <a class="resource-link" href="https://www.wikipedia.org/" target="_blank" rel="noopener noreferrer" style="color:#0f172a; font-size:14px; line-height:20px; font-weight:700; text-decoration:underline;">Wikipedia</a>
                        <div class="resource-description" style="margin-top:2px; color:#64748b; font-size:12px; line-height:18px;">Learn something new every day</div>
                    </td>
                    <td class="resource-row resource-arrow" align="right" style="padding:0; border-top:1px solid #e5e7eb; color:#0f766e; font-family:Arial,Helvetica,sans-serif; font-size:16px;"><a href="https://www.wikipedia.org/" target="_blank" rel="noopener noreferrer" aria-label="Open Wikipedia" style="display:block; padding:14px 0 14px 12px; color:inherit; text-decoration:none;">↗</a></td>
                </tr>
                <tr>
                    <td class="resource-row" width="42" valign="top" style="padding:14px 0; border-top:1px solid #e5e7eb;">
                        <span class="resource-badge resource-badge-microsoft" style="display:inline-block; padding:5px 8px; border-radius:7px; background-color:#16833b; color:#ffffff; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:16px; font-weight:700;">M</span>
                    </td>
                    <td class="resource-row" style="padding:14px 8px; border-top:1px solid #e5e7eb; font-family:Arial,Helvetica,sans-serif;">
                        <a class="resource-link" href="https://www.microsoft.com/" target="_blank" rel="noopener noreferrer" style="color:#0f172a; font-size:14px; line-height:20px; font-weight:700; text-decoration:underline;">Microsoft</a>
                        <div class="resource-description" style="margin-top:2px; color:#64748b; font-size:12px; line-height:18px;">Tools to create and get things done</div>
                    </td>
                    <td class="resource-row resource-arrow" align="right" style="padding:0; border-top:1px solid #e5e7eb; color:#0f766e; font-family:Arial,Helvetica,sans-serif; font-size:16px;"><a href="https://www.microsoft.com/" target="_blank" rel="noopener noreferrer" aria-label="Open Microsoft" style="display:block; padding:14px 0 14px 12px; color:inherit; text-decoration:none;">↗</a></td>
                </tr>
            </table>
        </td>
    </tr>
</table>

<p class="email-signoff" style="margin:22px 0 0; color:#475569; font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:20px;">
    Here’s to a curious start and great things ahead.
</p>
