@using EmailStudio.Studio
@using EmailStudio.Templates.Shared
@{
    var layoutModel = ViewData["EmailStudioLayout"] as LayoutModel;
    var brandName = layoutModel?.BrandName ?? "Your application";
    var title = ViewData["Title"] as string ?? brandName;
    var preheader = ViewData["Preheader"] as string ?? string.Empty;
    var footerText = layoutModel?.FooterText ?? $"This email has been automatically generated by EmailStudio for {brandName}";
}
<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml"
      xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="x-apple-disable-message-reformatting"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="color-scheme" content="light dark"/>
    <meta name="supported-color-schemes" content="light dark"/>
    <title>@title</title>
    <style>
        :root {
            color-scheme: light dark;
            supported-color-schemes: light dark;
        }

        .email-header {
            background-color: #101828;
        }

        .email-brand-name {
            color: #ffffff;
        }

        .body-copy {
            background-color: #ffffff;
            color: #111827;
        }

        .email-eyebrow, .resource-section-heading {
            color: #0f766e;
        }

        .email-heading {
            color: #101828;
        }

        .email-message, .resource-section-copy, .email-signoff {
            color: #475569;
        }

        .resource-card {
            background-color: #f8fafc;
            border-color: #e2e8f0;
        }

        .resource-row {
            border-top-color: #e5e7eb;
        }

        .resource-badge-google {
            background-color: #4285f4;
        }

        .resource-badge-linkedin {
            background-color: #0a66c2;
        }

        .resource-badge-github {
            background-color: #334155;
        }

        .resource-badge-wikipedia {
            background-color: #6257a5;
        }

        .resource-badge-microsoft {
            background-color: #16833b;
        }

        .resource-link {
            color: #0f172a;
        }

        .resource-description {
            color: #64748b;
        }

        .resource-arrow {
            color: #0f766e;
        }

        @@media (prefers-color-scheme: dark) {
            body, .page {
                background-color: #070b16 !important;
            }

            .card {
                background-color: #101a2a !important;
            }

            .email-header {
                background-color: #103a4b !important;
            }

            .email-brand-name {
                color: #f8fafc !important;
            }

            .body-copy {
                background-color: #18263a !important;
                color: #f1f5f9 !important;
            }

            .email-eyebrow, .resource-section-heading, .resource-arrow {
                color: #6ee7d1 !important;
            }

            .email-heading {
                color: #f8fafc !important;
            }

            .email-message, .resource-section-copy, .email-signoff {
                color: #d5deea !important;
            }

            .resource-card {
                background-color: #293b52 !important;
                border-color: #52677f !important;
            }

            .resource-row {
                border-top-color: #52677f !important;
            }

            .resource-link {
                color: #ffffff !important;
            }

            .resource-description {
                color: #d0d9e5 !important;
            }

            .resource-badge-google {
                background-color: #4285f4 !important;
            }

            .resource-badge-linkedin {
                background-color: #2782dc !important;
            }

            .resource-badge-github {
                background-color: #8998ad !important;
            }

            .resource-badge-wikipedia {
                background-color: #8b7cf6 !important;
            }

            .resource-badge-microsoft {
                background-color: #22a447 !important;
            }

            .footer {
                background-color: #0b1220 !important;
                color: #c4cedb !important;
            }
        }
    </style>
    <!--[if mso]>
    <xml>
        <o:OfficeDocumentSettings>
            <o:PixelsPerInch>96</o:PixelsPerInch>
            <o:AllowPNG/>
        </o:OfficeDocumentSettings>
    </xml>
    <![endif]-->
</head>
<body style="margin:0; padding:0; background-color:#f3f4f6;">
<div
    style="display:none; font-size:1px; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all;">
    @preheader
</div>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="page"
       style="background-color:#f3f4f6;">
    <tr>
        <td align="center" style="padding:24px 12px;">
            <!--[if mso]>
            <table role="presentation" width="760">
                <tr>
                    <td><![endif]-->
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="card"
                   style="max-width:760px; background-color:#ffffff; border-radius:14px; overflow:hidden;">
                <tr>
                    <td align="center" class="email-header" style="padding:22px 24px; background-color:#101828;">
                        <img src="@EmailLogo.Source" alt="@brandName" title="@brandName"
                             style="display:block; height:auto; max-width:100%; max-height:50px; border:0; outline:none; text-decoration:none;"/>
                    </td>
                </tr>
                <tr>
                    <td class="body-copy"
                        style="padding:28px 26px; background-color:#ffffff; color:#111827; font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:23px;">
                        @RenderBody()
                    </td>
                </tr>
                <tr>
                    <td class="footer"
                        style="padding:18px 24px; background-color:#f8fafc; color:#64748b; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:18px;">
                        @footerText
                    </td>
                </tr>
            </table>
            <!--[if mso]></td></tr></table><![endif]-->
        </td>
    </tr>
</table>
</body>
</html>
